+function promotionTags(shopData: Record<string, unknown>): string[] {
+  const tags = new Set<string>();
+  const visit = (value: unknown): void => {
+    if (typeof value === 'string') {
+      const text = value.trim();
+      if (text && text.length <= 80) tags.add(text);
+      return;
+    }
+    if (Array.isArray(value)) {
+      value.forEach(visit);
+      return;
+    }
+    if (value && typeof value === 'object') {
+      const record = value as Record<string, unknown>;
+      for (const key of ['text', 'content', 'label', 'title', 'description', 'activity_text', 'icon_text']) {
+        if (key in record) visit(record[key]);
+      }
+    }
+  };
+  for (const key of ['discounts2', 'discounts', 'activity_list', 'activity_info', 'promotion_info', 'poi_promotion_tags']) {
+    if (key in shopData) visit(shopData[key]);
+  }
+  return [...tags].slice(0, 20);
+}
