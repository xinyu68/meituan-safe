+  page?: number;
+  pageSize?: number;
+  queryId?: string;
+  requestId?: string;
+}
+
+interface DealApiEnvelope {
+  code?: number;
+  success?: boolean;
+  message?: string;
+  data?: Record<string, unknown>;
+}
+
+async function postJson(
+  url: string,
+  body: Record<string, unknown>,
+  token?: string
+): Promise<DealApiEnvelope> {
+  const headers: Record<string, string> = {
+    'Content-Type': 'application/json',
+    'User-Agent': 'Mozilla/5.0',
+  };
+  if (token) headers.token = token;
+  const response = await fetch(url, {
+    method: 'POST',
+    headers,
+    body: JSON.stringify(body),
+    signal: AbortSignal.timeout(15000),
+  });
+  if (!response.ok) {
+    throw new Error(`Meituan deal API returned HTTP ${response.status}`);
+  }
+  const contentType = response.headers.get('content-type') || '';
+  if (!contentType.includes('json')) {
+    throw new Error(`Meituan deal API returned non-JSON response (${contentType || 'unknown'})`);
+  }
+  return await response.json() as DealApiEnvelope;
+}
+
+export async function resolveDealLocation(address: string): Promise<{
+  cityId: string;
+  cityName?: string;
+  latitude?: number;
+  longitude?: number;
+}> {
+  const result = await postJson(LOCATION_URL, { address });
+  if (result.code !== 200 || !result.success || !result.data) {
+    throw new Error(`Deal location failed: ${result.message || String(result.code)}`);
+  }
+  return {
+    cityId: String(result.data.cityId ?? ''),
+    cityName: typeof result.data.cityName === 'string' ? result.data.cityName : undefined,
+    latitude: typeof result.data.lat === 'number' ? result.data.lat : undefined,
+    longitude: typeof result.data.lng === 'number' ? result.data.lng : undefined,
+  };
+}
+
+export async function searchDeals(session: Session, params: DealSearchParams): Promise<{
+  products: Array<Record<string, unknown>>;
+  isLastPage: boolean;
+  queryId: string;
+  requestId: string;
+  cityId: string;
+}> {
+  let cityId = params.cityId;
+  if (!cityId) {
+    if (!params.address) throw new Error('Address or city ID is required for deal search');
+    cityId = (await resolveDealLocation(params.address)).cityId;
+  }
+  if (!cityId) throw new Error('Meituan did not resolve a city ID');
+
+  const token = process.env.MEITUAN_SAFE_DEAL_TOKEN || session.token;
+  const body: Record<string, unknown> = {
+    keyword: params.keyword,
+    page: params.page ?? 1,
+    pageSize: String(params.pageSize ?? 10),
+    clientSource: 'coupon-fusion-workbuddy',
+    userParamDTO: {
+      lat: String(params.latitude),
+      lng: String(params.longitude),
+      token,
+      cityId,
+      app: 216,
+      platform: 1,
+      partner: 1018,
+    },
+  };
+  if (params.queryId) body.queryId = params.queryId;
+  if (params.requestId) body.requestId = params.requestId;
+
+  const result = await postJson(DEAL_SEARCH_URL, body, token);
+  if (result.code !== 200 || !result.success || !result.data) {
+    throw new Error(`Deal search failed: ${result.message || String(result.code)}`);
+  }
+  const rawProducts = result.data.productList;
+  const products = Array.isArray(rawProducts)
+    ? rawProducts.filter((item): item is Record<string, unknown> => Boolean(item && typeof item === 'object'))
+    : [];
+  return {
+    products,
+    isLastPage: Boolean(result.data.isLastPage),
+    queryId: String(result.data.queryId ?? ''),
+    requestId: String(result.data.requestId ?? ''),
+    cityId,
+  };
+}
