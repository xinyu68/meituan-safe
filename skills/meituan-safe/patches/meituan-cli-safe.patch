+
+export function buildDealCommand(): Command {
+  const deal = new Command('deal').description('Read-only Meituan in-store deal commands');
+
+  deal
+    .command('location')
+    .requiredOption('--address <address>', 'Named place or address')
+    .description('Resolve a Meituan city ID for in-store deals')
+    .action(async (opts, cmd) => {
+      const globalOpts = cmd.optsWithGlobals() as GlobalOpts;
+      try {
+        format(await resolveDealLocation(opts.address), { json: globalOpts.json });
+      } catch (err) {
+        formatError(err instanceof Error ? err.message : String(err), { json: globalOpts.json });
+      }
+    });
+
+  deal
+    .command('search')
+    .requiredOption('--keyword <keyword>', 'Deal or restaurant keyword')
+    .requiredOption('--lat <n>', 'GCJ-02 latitude', value => parseFloat(value))
+    .requiredOption('--lng <n>', 'GCJ-02 longitude', value => parseFloat(value))
+    .option('--address <address>', 'Named place used to resolve city ID')
+    .option('--city-id <id>', 'Meituan city ID')
+    .option('--page <n>', 'Page number (default: 1)', value => parseInt(value, 10), 1)
+    .option('--page-size <n>', 'Results per page, 1-20 (default: 10)', value => parseInt(value, 10), 10)
+    .option('--query-id <id>', 'Previous response query ID')
+    .option('--request-id <id>', 'Previous response request ID')
+    .description('Search nearby in-store group-buying deals')
+    .action(async (opts, cmd) => {
+      const globalOpts = cmd.optsWithGlobals() as GlobalOpts;
+      try {
+        if (!Number.isFinite(opts.lat) || opts.lat < -90 || opts.lat > 90 ||
+            !Number.isFinite(opts.lng) || opts.lng < -180 || opts.lng > 180) {
+          formatError('Invalid latitude or longitude.', { json: globalOpts.json });
+          return;
+        }
+        if (!Number.isInteger(opts.page) || opts.page < 1 ||
+            !Number.isInteger(opts.pageSize) || opts.pageSize < 1 || opts.pageSize > 20) {
+          formatError('Invalid deal page range.', { json: globalOpts.json });
+          return;
+        }
+        if (!opts.cityId && !opts.address) {
+          formatError('Provide --address or --city-id.', { json: globalOpts.json });
+          return;
+        }
+        const session = process.env.MEITUAN_SAFE_DEAL_TOKEN
+          ? { token: process.env.MEITUAN_SAFE_DEAL_TOKEN, cookieString: '', userAgent: '' }
+          : await requireAuth();
+        const result = await searchDeals(session, {
+          keyword: opts.keyword,
+          latitude: opts.lat,
+          longitude: opts.lng,
+          address: opts.address,
