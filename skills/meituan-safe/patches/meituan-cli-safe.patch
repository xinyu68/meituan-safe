+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { Command } from '@commander-js/extra-typings';
+import { requireAuth } from '../auth/session.js';
+import { searchDeals } from '../services/deal.js';
+import { buildDealCommand } from './deal.js';
+
+vi.mock('../auth/session.js', () => ({ requireAuth: vi.fn() }));
+vi.mock('../services/deal.js', () => ({ resolveDealLocation: vi.fn(), searchDeals: vi.fn() }));
+vi.mock('../output/formatter.js', () => ({ format: vi.fn(), formatError: vi.fn() }));
+
+afterEach(() => {
+  vi.unstubAllEnvs();
+  vi.clearAllMocks();
+});
+
+describe('deal command', () => {
+  it('uses Passport authorization without requiring an H5 session', async () => {
+    vi.stubEnv('MEITUAN_SAFE_DEAL_TOKEN', 'passport-token');
+    vi.mocked(searchDeals).mockResolvedValue({
+      products: [], isLastPage: true, queryId: '', requestId: '', cityId: '1',
+    });
+    const program = new Command('mt').addCommand(buildDealCommand());
+
+    await program.parseAsync([
+      'deal', 'search', '--keyword', '烧烤', '--lat', '40', '--lng', '116.47', '--city-id', '1',
+    ], { from: 'user' });
+
+    expect(requireAuth).not.toHaveBeenCalled();
+    expect(searchDeals).toHaveBeenCalledWith(
+      { token: 'passport-token', cookieString: '', userAgent: '' },
+      expect.objectContaining({ keyword: '烧烤', cityId: '1' }),
+    );
+  });
+});
